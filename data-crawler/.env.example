# 数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=personal-finance

# 数据库连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

# SQL查询日志输出（true/false）
SQL_ECHO=false

# 调试模式（true/false）
DEBUG=false

# Scheduler 内部通信地址（web 进程通过此地址转发控制指令到调度器进程）
# docker 部署时为 http://scheduler:5001，本地开发为 http://localhost:5001
SCHEDULER_INTERNAL_URL=http://scheduler:5001

# 会话签名密钥（登录态 Cookie 鉴权依赖）。生产环境务必改成自己的随机值
# 可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
SECRET_KEY=change-me-to-a-random-secret

# Cookie Secure 标志：仅 HTTPS 下启用（true），HTTP 部署保持 false，否则浏览器不会回传 Cookie 导致无法登录
FLASK_COOKIE_SECURE=false
