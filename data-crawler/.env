MYSQL_HOST=117.72.53.38
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=wangxuedi3319@
MYSQL_DATABASE=personal-finance

# 数据库连接池配置
# 连接池大小（核心连接数）
DB_POOL_SIZE=20

# 最大连接数（核心连接数 + 最大溢出连接数）
DB_MAX_OVERFLOW=30

# 连接在池中回收的时间（秒）
DB_POOL_RECYCLE=3600

# 从连接池获取连接的最大等待时间（秒）
DB_POOL_TIMEOUT=30

# SQL查询日志输出（true/false）
SQL_ECHO=true

# 调试模式（true/false）
DEBUG=false